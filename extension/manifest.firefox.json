{
  "manifest_version": 2,
  "name": "Browser Proxy",
  "description": "Safely relay allowlisted HTTP requests through your browser session.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "nativeMessaging", "storage", "webRequest", "webRequestBlocking", "scripting", "<all_urls>"],
  "background": {
    "scripts": ["policy.js", "redirects.js", "redirect-observer.js", "tab-settings.js", "tab-context.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Browser Proxy",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-proxy@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
