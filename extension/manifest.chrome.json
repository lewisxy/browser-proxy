{
  "manifest_version": 3,
  "name": "Browser Proxy",
  "description": "Safely relay allowlisted HTTP requests through your browser session.",
  "version": "0.1.0",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background-loader.js"
  },
  "action": {
    "default_title": "Browser Proxy",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
